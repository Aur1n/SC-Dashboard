          "labels": "show",
          "span": [
            3,
            1
          ]
        },
        {
          "type": "button",
          "id": "right-mfd-ifcs",
          "icon": "speed",
          "label": "IFCS",
          "voice": false,
          "keys": "rctrl+2",
          "scAction": "v_mfd_soft_select_mfd_2_short",
          "then": [
            {
              "keys": "rctrl+period",
              "scAction": "v_mfd_select_view_ifcs_short"
            }
          ],
          "mode": "tap",
          "labels": "show",
          "span": [
            3,
            1
          ]
        },
        {
          "type": "button",
          "id": "right-mfd-repair",
