            }
          ],
          "mode": "tap",
          "labels": "show",
          "span": [
            3,
            1
          ]
        },
        {
          "type": "button",
          "id": "right-mfd-scanning",
          "icon": "target",
          "label": "Scanning",
          "voice": false,
          "keys": "rctrl+2",
          "scAction": "v_mfd_soft_select_mfd_2_short",
