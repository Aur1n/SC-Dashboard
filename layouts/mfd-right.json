            {
              "keys": "rctrl+9",
              "scAction": "v_mfd_select_view_configuration_short"
            }
          ],
          "mode": "tap",
          "labels": "show",
          "span": [
            3,
            1
          ]
        },
        {
          "type": "button",
          "id": "right-mfd-diagnostics",
          "icon": "power-reset",
          "label": "Diagnostics",
          "voice": false,
          "keys": "rctrl+2",
          "scAction": "v_mfd_soft_select_mfd_2_short",
          "then": [
            {
              "keys": "rctrl+0",
