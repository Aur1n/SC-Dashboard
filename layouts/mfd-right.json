{
  "name": "Right MFD",
  "notes": "One tablet for the right MFD (MFD 2 in Star Citizen): each button selects that screen (Right Ctrl+2), then sends its page or move. The page and move actions are unbound in the game by default; the SC-Dashboard Keyboard profile binds them on Right Ctrl. One way only: a page picked in the game with the mouse doesn't show here.",
  "grid": {
    "version": 3,
    "density": {
      "small": "default",
      "large": "default"
    },
    "halves": {
      "left": [
        "pages"
      ],
      "right": [
        "nav"
      ]
    },
    "full": []
  },
  "chrome": [
    {
      "type": "action",
      "action": "menu",
      "icon": "emblem",
      "bar": "left"
    },
    {
      "type": "status",
      "bar": "left"
    },
    {
      "type": "talk",
      "label": "Hold to talk",
      "bar": "right"
    },
    {
      "type": "voicehelp",
      "bar": "right"
    },
    {
      "type": "action",
      "action": "theme",
      "icon": "sliders",
      "bar": "right"
    }
  ],
  "panels": {
    "pages": {
      "title": "Pages",
      "cols": 6,
      "elements": [
        {
          "type": "button",
          "id": "right-mfd-resource_network",
          "icon": "power",
          "label": "Power",
          "voice": false,
          "keys": "rctrl+2",
          "scAction": "v_mfd_soft_select_mfd_2_short",
          "then": [
            {
              "keys": "rctrl+3",
              "scAction": "v_mfd_select_view_resource_network_short"
            }
          ],
          "mode": "tap",
          "labels": "show",
          "span": [
            3,
            1
          ],
          "color": "green"
        },
        {
          "type": "button",
          "id": "right-mfd-self_status",
          "icon": "power-shields",
          "label": "Self status",
          "voice": false,
          "keys": "rctrl+2",
          "scAction": "v_mfd_soft_select_mfd_2_short",
          "then": [
            {
              "keys": "rctrl+4",
              "scAction": "v_mfd_select_view_self_status_short"
            }
          ],
          "mode": "tap",
          "labels": "show",
          "span": [
            3,
            1
          ],
          "color": "blue"
        },
        {
          "type": "button",
          "id": "right-mfd-target_status",
          "icon": "target",
          "label": "Target status",
          "voice": false,
          "keys": "rctrl+2",
          "scAction": "v_mfd_soft_select_mfd_2_short",
          "then": [
            {
              "keys": "rctrl+5",
              "scAction": "v_mfd_select_view_target_status_short"
            }
          ],
          "mode": "tap",
          "labels": "show",
          "span": [
            3,
            1
          ],
          "color": "amber"
        },
        {
          "type": "button",
          "id": "right-mfd-comms",
          "icon": "chat",
          "label": "Comms",
          "voice": false,
          "keys": "rctrl+2",
          "scAction": "v_mfd_soft_select_mfd_2_short",
          "then": [
            {
              "keys": "rctrl+6",
              "scAction": "v_mfd_select_view_comms_short"
            }
          ],
          "mode": "tap",
          "labels": "show",
          "span": [
            3,
            1
          ]
        },
        {
          "type": "button",
          "id": "right-mfd-configuration",
          "icon": "swap",
          "label": "Configuration",
          "voice": false,
          "keys": "rctrl+2",
          "scAction": "v_mfd_soft_select_mfd_2_short",
